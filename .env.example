# AnchorNode Console Environment Configuration
# Copy this file to .env to customize local or live backend connections

# Live REST API Endpoint
VITE_API_BASE_URL=http://localhost:8080/api

# Real-time WebSocket / SSE Cluster Events Endpoint
VITE_WS_URL=ws://localhost:8080/events

# Auth JWT Config (for backend reference)
JWT_SECRET=replace-with-a-real-secret
JWT_EXPIRES_IN=7d
